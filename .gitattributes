# Go sources and text fixtures check out with LF on every OS: gofmt
# flags CRLF sources, and CRLF wordlists would poison word lookups.
*.go text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sh text eol=lf
# Generated completions and man page: byte-compared against LF
# generator output, consumed by Unix shells/man, and shipped in
# deb/rpm payloads — CRLF would break freshness and consumers.
packaging/completion/** text eol=lf
packaging/man/** text eol=lf
# Binary fixtures must never be line-ending converted.
detector/testdata/** binary
